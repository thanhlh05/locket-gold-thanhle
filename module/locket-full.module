#!name=Locket Gold Full
#!desc=Mở khóa Gold đầy đủ - Video 60s - Caption dài - Unlimited friends - Tắt ads
#!author=Thanh Lê

[Script]
# RevenueCat - Giả mạo Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold/main/scripts/locket.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold/main/scripts/delheader.js, timeout=30

# Firebase Remote Config - Ép full tính năng
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold/main/scripts/forceGold.js, requires-body=true, max-size=-1, timeout=60, script-update-interval=3600

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com